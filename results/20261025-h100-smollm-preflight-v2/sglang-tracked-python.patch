+        A,
+        B,
+        b_desc,
+        C,
+        C_scale,
+        A_scale,
+        B_scale,
+        sorted_token_ids,
+        expert_ids,
+        num_tokens_post_padded,
+        C.shape[1],
+        B.shape[2],
+        sorted_token_ids.shape[0],
+        topk_ids.numel(),
+        A.stride(0),
+        A.stride(1),
+        B.stride(0),
+        B.stride(2),
+        B.stride(1),
+        C.stride(0),
+        C.stride(1),
+        C_scale.stride(0),
+        C_scale.stride(1),
+        A_scale.stride(0),
+        A_scale.stride(1),
+        B_scale.stride(0),
+        B_scale.stride(2),
+        B_scale.stride(1),
+        group_n=group_n,
+        group_k=group_k,
+        top_k=topk_ids.shape[1],
+        compute_type=compute_type,
+        FP8_DTYPE=fp8_dtype_to_triton(fp8_dtype),
+        even_Ks=B.shape[2] % config["BLOCK_SIZE_K"] == 0,
+        c_sorted=c_sorted,
+        filter_expert=filter_expert,
