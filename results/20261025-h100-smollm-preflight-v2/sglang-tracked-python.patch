+def invoke_fused_moe_gemm1_swiglu_quant_kernel(
+    A: torch.Tensor,
+    B: torch.Tensor,
+    C: torch.Tensor,
+    C_scale: torch.Tensor,
+    A_scale: torch.Tensor,
+    B_scale: torch.Tensor,
+    sorted_token_ids: torch.Tensor,
+    expert_ids: torch.Tensor,
+    num_tokens_post_padded: torch.Tensor,
+    topk_ids: torch.Tensor,
+    config: Dict[str, Any],
+    compute_type: tl.dtype,
+    block_shape: List[int],
+    *,
+    c_sorted: bool,
+    b_use_tma: bool,
+    filter_expert: bool,
+) -> None:
+    """Launch the model-specific FP8 GEMM1+SwiGLU+quant fast path."""
+    group_n, group_k = block_shape
+    assert A.dtype == fp8_dtype and A_scale is not None
+    assert B.dtype == fp8_dtype and B_scale is not None
+    assert B.shape[1] % 2 == 0
+    assert B.shape[1] // 2 == C.shape[1]
+    assert C.dtype == fp8_dtype and C.is_contiguous()
+    assert C_scale.dtype == torch.float32 and C_scale.is_contiguous()
+    assert config["BLOCK_SIZE_N"] == group_n == group_k
+    assert C.shape[1] % group_k == 0
+
+    if b_use_tma:
+        _set_triton_tma_allocator()
+        b_desc = _get_b_tma_desc_cached(
+            B, config["BLOCK_SIZE_N"], config["BLOCK_SIZE_K"]
+        )
+    else:
+        b_desc = None
+
+    grid = lambda META: (
+        triton.cdiv(sorted_token_ids.shape[0], META["BLOCK_SIZE_M"])
+        * triton.cdiv(C.shape[1], META["BLOCK_SIZE_N"]),
+    )
